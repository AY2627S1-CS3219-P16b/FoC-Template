# Copy to .env (git-ignored) and replace every value before the first startup:
#   cp .env.example .env
# Generate each value with: openssl rand -hex 32
# Hex values are safe inside the database URLs; avoid @ : / in passwords.
#
# PostgreSQL applies a database password only when its volume is first created.
# Changing it later does not change the stored password; recreate the volume
# (erasing that database) or change it inside PostgreSQL as well.

# Service-to-service credentials; keep the two distinct.
USER_SERVICE_KEY=replace-me
ORDER_SERVICE_KEY=replace-me

# One password per database server.
USER_DB_PASSWORD=replace-me
SUPPLIER_DB_PASSWORD=replace-me
CREDIT_DB_PASSWORD=replace-me
ORDER_DB_PASSWORD=replace-me
