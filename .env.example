# Service-to-service credentials
USER_SERVICE_KEY=replace-me
ORDER_SERVICE_KEY=replace-me

# One password per database server.
USER_DB_PASSWORD=replace-me
SUPPLIER_DB_PASSWORD=replace-me
CREDIT_DB_PASSWORD=replace-me
ORDER_DB_PASSWORD=replace-me
FAQ_DB_PASSWORD=replace-me

# FAQ answers use Anthropic directly; embeddings run locally without AWS.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Initial retrieval threshold: validate with your own FAQ questions.
FAQ_MIN_SIMILARITY=0.65
FAQ_REQUESTS_PER_MINUTE=30
